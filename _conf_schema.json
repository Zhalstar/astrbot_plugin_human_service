{
    "servicers_id": {
        "description": "客服列表",
        "hint": "填写客服的QQ号。若不填则默认从全局配置中加载管理员作为客服",
        "type": "list",
        "default": [],
        "_special": "sender_id"
    },
    "blacklist": {
        "description": "全局黑名单",
        "hint": "填写禁止使用人工客服的用户QQ号，客服命令产生的变更也会自动保存到此列表",
        "type": "list",
        "default": [],
        "_special": "sender_id"
    },
    "conversation_idle_timeout": {
        "description": "对话空闲超时（秒）",
        "hint": "用户和客服连续多久没有发送消息后结束对话并接入下一位，在插件收到后续消息时检查。设置为0表示不限制",
        "type": "int",
        "slider": {
            "min": 0,
            "max": 600,
            "step": 10
        },
        "default": 300
    },
    "queue_timeout": {
        "description": "排队时间限制（秒）",
        "hint": "用户最大排队等待时长（秒）。设置为0表示不限制。超时后会自动移出队列并通知用户",
        "type": "int",
        "slider": {
            "min": 0,
            "max": 600,
            "step": 10
        },
        "default": 300
    }
}